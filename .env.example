# ===== 激活邮件发送（Brevo SMTP）=====
# Brevo 后台：https://app.brevo.com/ → 左侧「SMTP & API」→ 复制 SMTP 服务器登录与 SMTP Key
# 注意：SMTP_PASS 是「SMTP Key」（非账号密码）；SMTP_USER 通常是注册邮箱或专用 SMTP 登录名。
# Brevo 要求 from 地址为已验证发件人（账户邮箱默认已验证；自定义域名需先在 Brevo 验证）。

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login@example.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=your-brevo-smtp-login@example.com

# 开发环境：把激活码回显到接口便于本地验证（production 务必设为 false）
ACTIVATION_DEV_ECHO=true

# 其他 provider 示例（取消注释并改值即可切换）：
# MailerSend: SMTP_HOST=smtp.mailersend.net  SMTP_PORT=587  SMTP_USER=<api-user>  SMTP_PASS=<api-key>
# QQ 邮箱:     SMTP_HOST=smtp.qq.com         SMTP_PORT=587  SMTP_USER=<qq号>@qq.com  SMTP_PASS=<授权码>
# 腾讯云邮件推送: SMTP_HOST=ses.tencentcloud.com  SMTP_PORT=587  SMTP_USER=<用户名>  SMTP_PASS=<密码>
