# ===== 数据库（容器内 pgvector/pgvector:pg16）=====
PGUSER=agent2b
# ⚠️ 必须改成强随机密码（deploy.sh 首次运行会复制本文件为 .env 并提示你修改）
PGPASSWORD=请改成强密码
PGDATABASE=crm_native

# ===== Node 服务 =====
NODE_ENV=production
PORT=3000

# ===== embedding 真语义向量 =====
# 默认开启 model 路径（compose 默认已为 model）；crm.llm_config 须含 SiliconFlow api_key，否则 fail-open 写 NULL。
# 显式留空可强制降级 hash（不推荐）。
EMBEDDING_PROVIDER=model

# ===== 激活邮件通道（自助注册 → 手机/邮箱激活）=====
# 当前采用 163 邮箱 SMTP（无需新注册，用您已有的 watchm@163.com）。
# 关键：SMTP_PASS 是 163 邮箱「设置 → 客户端授权密码」生成的【授权码】，不是登录密码。
# 想换 Brevo/腾讯云/阿里云：改 SMTP_HOST/PORT/SECURE 即可（代码 SMTP 协议无关，已透传进容器）。
# 配置后激活邮件真实发出；不配置则生产环境无法发码（NODE_ENV=production 不回显 devCode）。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=watchm@163.com
SMTP_PASS=
SMTP_FROM=watchm@163.com

# ===== 域名（仅 Nginx HTTPS 用，先用 IP 访问可留空）=====
DOMAIN=

# ===== 凭据保险库对称加密密钥（PGCRYPTO_SYM_KEY）=====
# 用途：POST /api/integration/secret「填 Key 授权」保存外部数据源凭据时，pgcrypto pgp_sym_encrypt 的对称密钥。
# 缺失 → 保存被 fail-closed 拒绝（HTTP 400「PGCRYPTO_SYM_KEY 未配置」），即「配置里无法保存」。
# 生成（32 字节十六进制，强随机）：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 约束：app 与 mcp 服务必须一致；integration-secrets 当前为空，可设全新值；设后勿随意轮换（历史凭据不可解密）。
PGCRYPTO_SYM_KEY=
