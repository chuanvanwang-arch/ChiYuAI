    <Box style={{ marginTop: 16, background: '#13161E', borderRadius: 12, border: '1px dashed #2C3346', padding: 16, paddingLeft: 20, paddingRight: 20, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
      <Box style={{ paddingTop: 5, paddingBottom: 5, paddingLeft: 12, paddingRight: 12, borderRadius: 6, background: 'rgba(251,191,36,.14)' }}>
        <Text style={{ fontSize: 14, color: '#FBBF24', fontWeight: 'bold' }}>主动认弱</Text>
      </Box>
      <Text style={{ fontSize: 16, color: '#A4ABBD', flex: 1, lineHeight: 1.6 }}>
        设备接入协议、组态看板、规模与生态成熟度三项，我们不如存量平台——这些维度<b>不宣称更强</b>，采用集成而非重建。
