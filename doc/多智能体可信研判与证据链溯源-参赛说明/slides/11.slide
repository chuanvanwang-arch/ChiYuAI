      </Box>

      <Box style={{ background: '#161A24', borderRadius: 12, border: '1px solid #232838', borderLeft: '3px solid #60A5FA', padding: 16, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Box style={{ paddingTop: 5, paddingBottom: 5, paddingLeft: 12, paddingRight: 12, borderRadius: 6, background: 'rgba(96,165,250,.14)', width: 90, alignItems: 'center' }}>
