<Slide style={{ background: '#0C0E14', paddingTop: 20, paddingBottom: 20, paddingLeft: 64, paddingRight: 64, fontFamily: 'Microsoft YaHei', flexDirection: 'row', alignItems: 'center', gap: 44 }}>

