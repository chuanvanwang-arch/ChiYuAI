        <Box style={{ paddingTop: 5, paddingBottom: 5, paddingLeft: 12, paddingRight: 12, borderRadius: 6, background: 'rgba(52,211,153,.14)', width: 90, alignItems: 'center' }}>
          <Text style={{ fontSize: 13.5, color: '#34D399', fontWeight: 'bold' }}>已完成</Text>
        </Box>
        <Text style={{ fontSize: 15.5, color: '#A4ABBD', flex: 1, lineHeight: 1.6 }}>
