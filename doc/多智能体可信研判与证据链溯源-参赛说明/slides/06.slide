<Slide style={{ background: '#0C0E14', paddingTop: 36, paddingBottom: 20, paddingLeft: 64, paddingRight: 64, fontFamily: 'Microsoft YaHei', flexDirection: 'column' }}>

  <Box style={{ height: 62, flexDirection: 'column', justifyContent: 'center' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 6 }}>
      <Box style={{ width: 36, height: 3, background: '#22D3EE' }} />
      <Text style={{ fontSize: 15, color: '#22D3EE', letterSpacing: 2, fontWeight: 'bold' }}>ARCHITECTURE</Text>
    </Box>
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#EEF1F6' }}>三层智能体：研判、消解、追溯各司其职</Text>
  </Box>

  <Box style={{ flex: 1, marginTop: 10, flexDirection: 'row', gap: 24 }}>

    <Box style={{ flex: 1 }}>
      <svg width={720} height={432} viewBox='0 0 720 432'>
        <rect x='0' y='6' width='720' height='118' rx='14' fill='#12161F' stroke='#22D3EE' strokeWidth='1.5' strokeDasharray='6 4' opacity='0.55' />
        <text x='18' y='34' fill='#22D3EE' fontSize='15' fontWeight='bold' fontFamily='Microsoft YaHei'>L0 · 研判智能体集群（并行，各持独立视角）</text>
        <rect x='18' y='48' width='158' height='58' rx='9' fill='#161A24' stroke='#22D3EE' strokeWidth='1.5' />
